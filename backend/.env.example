DATABASE_URL=postgresql://codevest:codevest@localhost:5432/codevest
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# "development" | "staging" | "production"
# In production: JWT_SECRET_KEY must not be the default, ALLOWED_ORIGINS must
# be set, and API docs are force-disabled — see app/core/config.py.
ENVIRONMENT=development
# Comma-separated list, no wildcard. Example for production:
# ALLOWED_ORIGINS=https://lender.codevest.gov.in,https://admin.codevest.gov.in
ALLOWED_ORIGINS=http://localhost:3000
# Field-level encryption key for PII columns (phone, registration numbers,
# MFA secrets). REQUIRED before creating/reading any User or Business row —
# EncryptedString raises immediately if this is unset, in dev too.
# Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Field-level encryption key for PII columns (User.phone, Business.registration_number,
# User.mfa_secret). REQUIRED before running seed.py or any request that writes one of
# those fields — leaving this blank raises immediately rather than silently storing
# plaintext. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
MFA_ISSUER_NAME=CodeVest
KYC_PROVIDER=mock
PAYMENT_PROVIDER=mock
# Optional. If unset, login rate limiting falls back to in-process memory
# (fine for a single worker; not safe across multiple instances).
REDIS_URL=
PASSWORD_MIN_LENGTH=10
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
EXPOSE_API_DOCS=true
